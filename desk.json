{
  "note": "The desk register: what this newsroom is configured to run, in one place. Two checks read it. The canary asserts the workflow files match it exactly, so a stale cron or a placeholder cannot survive a push. The morning tally compares the Actions log and the ledger to it and prints one health line. Cron times are UTC; the ET column is Eastern and shifts by an hour when DST ends on 1 November.",
  "desk": "gocheckmysports",
  "updated": "2026-09-17",
  "paid_runs_per_day": 1,
  "breaking_runs_per_day": 0,
  "spend_cap_usd_per_run": 1.5,
  "served_slots": [
    "evening-brief"
  ],
  "netlify_builds_per_day": {
    "min": 1,
    "max": 6
  },
  "worker_dispatches": [
    "inactives.yml in its posting windows",
    "sports-news-brief.yml at the evening slot, as the cron's backstop"
  ],
  "workflows": {
    "sports-news-brief.yml": {
      "purpose": "The one Edition run a day. Ingest, edit, verify, write, approve, publish.",
      "crons": [
        {
          "utc": "38 23 * * *",
          "et": "7:38 PM",
          "slot": "evening-brief"
        }
      ],
      "triggers": [
        "schedule",
        "workflow_dispatch",
        "workflow_call"
      ],
      "runs_per_day": {
        "min": 1,
        "max": 6
      },
      "paid_runs_per_day": {
        "min": 0,
        "max": 1
      },
      "note": "Runs beyond the first stand down at the slot guard and cost nothing."
    },
    "inactives.yml": {
      "purpose": "The Sunday inactives poller. Its dated snapshots are the record.",
      "crons": [
        {
          "utc": "*/15 15-23 * * 0",
          "et": "Sun 11:00 AM-7:59 PM",
          "slot": null
        },
        {
          "utc": "*/20 0-4 * * 1,2,5,6",
          "et": "night games after UTC midnight",
          "slot": null
        },
        {
          "utc": "*/20 22-23 * * 1,4,5",
          "et": "Mon/Thu/Fri 6:00-7:59 PM",
          "slot": null
        },
        {
          "utc": "*/20 0-4 * * 5",
          "et": "Thu night after UTC midnight",
          "slot": null
        },
        {
          "utc": "*/15 16-23 * * 6",
          "et": "Sat 12:00-7:59 PM",
          "slot": null
        }
      ],
      "triggers": [
        "schedule",
        "workflow_dispatch"
      ],
      "runs_per_day": {
        "min": 0,
        "max": 200
      },
      "paid_runs_per_day": {
        "min": 0,
        "max": 0
      },
      "note": "No model calls. A tick that captures nothing costs seconds and no commit."
    },
    "verify-sports-pipeline.yml": {
      "purpose": "The pipeline verification ladder.",
      "crons": [
        {
          "utc": "23 6 * * 1",
          "et": "Mon 2:23 AM",
          "slot": null
        }
      ],
      "triggers": [
        "schedule",
        "workflow_dispatch",
        "push"
      ],
      "runs_per_day": {
        "min": 0,
        "max": 40
      },
      "paid_runs_per_day": {
        "min": 0,
        "max": 0
      },
      "note": "Also runs on every push. Layer 1 is offline and makes no model call."
    },
    "sports-aging.yml": {
      "purpose": "Monthly aging review, and the venue-corrections review listing.",
      "crons": [
        {
          "utc": "0 13 1 * *",
          "et": "1st, 9:00 AM",
          "slot": null
        }
      ],
      "triggers": [
        "schedule",
        "workflow_dispatch"
      ],
      "runs_per_day": {
        "min": 0,
        "max": 1
      },
      "paid_runs_per_day": {
        "min": 0,
        "max": 0
      }
    },
    "janitor.yml": {
      "purpose": "Closes stale auto-alarm issues.",
      "crons": [
        {
          "utc": "40 7 * * *",
          "et": "3:40 AM",
          "slot": null
        }
      ],
      "triggers": [
        "schedule",
        "workflow_dispatch"
      ],
      "runs_per_day": {
        "min": 1,
        "max": 1
      },
      "paid_runs_per_day": {
        "min": 0,
        "max": 0
      }
    },
    "publicist.yml": {
      "purpose": "LinkedIn posting. Dispatch only.",
      "crons": [],
      "triggers": [
        "workflow_dispatch"
      ],
      "runs_per_day": {
        "min": 0,
        "max": 4
      },
      "paid_runs_per_day": {
        "min": 0,
        "max": 0
      }
    }
  }
}
